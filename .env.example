# ============================================================
# ENVIRONMENT VARIABLES
# Copy this file to ".env" locally for `vercel dev`,
# and add these same keys in the Vercel Dashboard for production:
#   Project -> Settings -> Environment Variables
# ============================================================

# Groq API key (used ONLY in /api/explain.js — server side, never exposed to browser)
# Get it from: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# NOTE: Supabase URL and anon key are NOT put here.
# They are public-safe values used directly in public/config.js,
# since the anon key is designed to be used client-side (protected by Row Level Security).
